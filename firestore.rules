rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // The one admin is whoever created config/admin (done from the site's
    // "Create Admin Account" screen the first time it's opened).
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/config/admin)
        && get(/databases/$(database)/documents/config/admin).data.uid == request.auth.uid;
    }

    // Everyone can watch the scoreboard; only the admin can change it.
    match /teams/{teamId} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 40
        && request.resource.data.score is number
        && request.resource.data.photo is string
        && request.resource.data.photo.size() < 400000;
      allow delete: if isAdmin();
    }

    // Can be created exactly once, by a signed-in user naming themselves.
    // To reset the admin, delete this document in the Firebase console.
    match /config/admin {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid', 'username'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.username is string;
      allow update, delete: if false;
    }
  }
}
