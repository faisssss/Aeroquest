rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // The one admin login ("Admin" on the site). Firebase Auth checks the password.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'admin@aeroquest-admin.com';
    }

    // Everyone can watch the scoreboard; only the admin can change it.
    match /teams/{teamId} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 40
        && request.resource.data.score is number
        && request.resource.data.photo is string
        && request.resource.data.photo.size() < 400000;
      allow delete: if isAdmin();
    }

  }
}
